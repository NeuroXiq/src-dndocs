[Unit]
Description=DNDocs.App.Web - DevTest
After=network.target

[Service]
WorkingDirectory=/mnt/usb2/dndocs/dndocs-app-devtest
ExecStart=/usr/bin/dotnet /mnt/usb2/dndocs/dndocs-app-devtest/DNDocs.App.Web.dll
Restart=always
