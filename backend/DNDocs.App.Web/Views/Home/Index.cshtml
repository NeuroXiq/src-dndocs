@section Css
{
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&family=Space+Grotesk:wght@300..700&display=swap" rel="stylesheet">
    <link rel="stylesheet" type="text/css" href="~/css-views/home/index.css" asp-append-version="true">
}

@section Scripts
{
    <script type="module" src="~/js-views/home/index.js" asp-append-version="true"></script>
}

<div class="home">
    <header>
        <h1>DNDocs</h1>
        <div class="logo">
            <div class="nletter">.N</div>
        </div>
    </header>
    <main>
        <div class="container is-max-desktop">
            <section class="section pb-0">
                <form class="box" id="form">
                    <h3 class="title">GENERATE API DOCS</h3>
                    <div class="field">
                        <label class="label">Package Name</label>
                        <div class="control">
                            <input class="input" type="text" name="packagename" />
                        </div>
                    </div>
                    <div class="field">
                        <label class="label">Package Version</label>
                        <div class="control">
                            <input class="input" type="text" name="packageversion" />
                        </div>
                    </div>
                    <div class="field">
                        <div class="control">
                            <button class="button is-link">Explore</button>
                        </div>
                    </div>
                </form>

            </section>
            <section class="section pt-0">

                <div style="display: flex; flex-wrap: wrap; justify-content: center;">

                    <a href="https://www.google.com/"
                       target="_blank"
                       class="tag is-link is-medium is-success is-light m-2">
                        <span class="icon" style="margin-right: 8px">
                            <i class="fa-brands fa-github"></i>
                        </span>
                        DNDOCS GITHUB
                    </a>

                    <a href="https://www.google.com/"
                       target="_blank"
                       class="tag is-link is-medium is-link is-light m-2">
                        <span class="icon" style="margin-right: 8px">
                            <i class="fa-brands fa-github"></i>
                        </span>
                        ALL PROJECTS
                    </a>
                    
                    <a href="https://www.google.com/"
                       target="_blank"
                       class="tag is-link is-medium is-info is-light m-2">
                        <span class="icon" style="margin-right: 8px">
                            <i class="fa-brands fa-github"></i>
                        </span>
                        SOURCE CODE
                    </a>
                    <a href="https://www.google.com/"
                       target="_blank"
                       class="tag is-link is-medium is-danger  is-light m-2">
                        <span class="icon" style="margin-right: 8px">
                            <i class="fa-solid fa-bug"></i>
                        </span>
                        REPORT ISSUE
                    </a>
                </div>
            </section>
            <section class="section pt-0">
                <div class="stepper columns" id="progress-stepper">
                    <div class="column notification m-2">
                        step 1
                        </div>
                    <div class="column notification m-2">step 3</div>
                    <div class="column notification m-2">step 4</div>
                    <div class="column notification m-2">step 2</div>
                </div>
            </section>
            <section class="section error is-hidden" id="section-errors">
                <div class="notification is-danger" id="error-message">
                </div>
            </section>
        </div>
    </main>
</div>

