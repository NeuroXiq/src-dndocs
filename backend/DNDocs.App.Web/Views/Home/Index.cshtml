@{
}
@section Css
{
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&family=Space+Grotesk:wght@300..700&display=swap" rel="stylesheet">
    <link rel="stylesheet" type="text/css" href="~/css-views/home/index.css">
}

@section Scripts
{
    <script type="text/javascript" src="~/js-views/home/index.js"></script>
}

<div class="home">
    <header>
        <h1>DNDocs</h1>
        <div class="logo">
            <div class="nletter">.N</div>
        </div>
    </header>
    <main>
        <div class="container is-max-tablet">
            <form class="box" id="form">
                <div class="field">
                    <label class="label">Package Name</label>
                    <div class="control">
                        <input class="input" type="text" name="packagename" />
                    </div>
                </div>
                <div class="field">
                    <label class="label">Package Version</label>
                    <div class="control">
                        <input class="input" type="text" name="packageversion" />
                    </div>
                </div>
                <div class="field">
                    <div class="control">
                        <button class="button is-link">Explore</button>
                    </div>
                </div>
            </form>
        </div>
    </main>
</div>

