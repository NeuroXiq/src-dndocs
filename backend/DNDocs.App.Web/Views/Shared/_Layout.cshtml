@{
@inject IWebHostEnvironment webHostEnvironment;
}

<!DOCTYPE html>
<html class="theme-light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width; initial-scale=1.0" />
    <title>DNDocs - NuGet package explorer</title>
    <link href="~/lib/fontawesome-free-7.2.0-web/css/all.css" rel="stylesheet" />
    <link rel="stylesheet" type="text/css" href="/css-shared/main.css">
    <link rel="stylesheet" type="text/css" href="/lib/bulma-1.0.4/css/bulma.css">
    @RenderSection("Css", required: false)
    <script type="module" src="~/js-shared/main.js"></script>
    <script type="module" src="~/js-shared/tools.js"></script>
    @RenderSection("Scripts", required: false)
    </head>
<body>
    @RenderBody()

    <environment exclude="Production">
        <div style="width: 250px; height: 50px; position: fixed; bottom: 0; right: 0; background-color: yellow">
            @webHostEnvironment.EnvironmentName
        </div>
    </environment>
</body>
</html>