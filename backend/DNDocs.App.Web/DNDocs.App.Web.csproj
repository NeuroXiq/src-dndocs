<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>$(dn_packageid)</PackageId>
    <Title>$(dn_title)</Title>
    <Version>$(dn_version)</Version>
    <InformationalVersion>$(dn_informationalversion)</InformationalVersion>
    <Authors>$(dn_author)</Authors>
    <Company>$(dn_company)</Company>
    <Product>$(dn_product)</Product>
    <Description>$(dn_description)</Description>
    <Copyright>$(dn_copyright)</Copyright>
    <PackageProjectUrl>$(dn_packageprojecturl)</PackageProjectUrl>
    <AssemblyVersion>$(dn_assemblyversion)</AssemblyVersion>
    <FileVersion>$(dn_fileversion)</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Helpers\**" />
    <Compile Remove="Models\Admin\**" />
    <Compile Remove="Models\Home\**" />
    <Content Remove="Helpers\**" />
    <Content Remove="Models\Admin\**" />
    <Content Remove="Models\Home\**" />
    <EmbeddedResource Remove="Helpers\**" />
    <EmbeddedResource Remove="Models\Admin\**" />
    <EmbeddedResource Remove="Models\Home\**" />
    <None Remove="Helpers\**" />
    <None Remove="Models\Admin\**" />
    <None Remove="Models\Home\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" Version="12.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DNDocs.Docs.Api\DNDocs.Docs.Api.csproj" />
    <ProjectReference Include="..\DNDocs.App.Domain\DNDocs.App.Domain.csproj" />
    <ProjectReference Include="..\DNDocs.App.Application\DNDocs.App.Application.csproj" />
    <ProjectReference Include="..\DNDocs.App.Infrastructure\DNDocs.App.Infrastructure.csproj" />
    <ProjectReference Include="..\DNDocs.Job.Api\DNDocs.Job.Api.csproj" />
    <ProjectReference Include="..\DNDocs.Shared\DNDocs.Shared.csproj" />
  </ItemGroup>



  <ItemGroup>
    <Content Update="wwwroot\.gitignore">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
