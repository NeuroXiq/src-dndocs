{
  "DNDocsSettings": {
    "Jwt": {
      "Issuer": "{Jwt_Issuer}",
      "Audience": "{Jwt_Audience}",
      "SymmetricSecurityKey": "{Jwt_SymmetricSecurityKey}"
    },
    "UrlProjectNugetOrgApiFolder": "{UrlProjectNugetOrgApiFolder}",
    "UrlProjectAllVersionsList": "{UrlProjectAllVersionsList}",
    "BackendBackgroundWorkerDoImportantWorkSleepSeconds": 10,
    "BackendBackgroundWorkerDoWorkSleepSeconds": 120,
    "FrontendBackgroundWorkerDoWorkSleepSeconds": 120,
    "OSPathInfrastructureDirectory": "{OSPathInfrastructureDirectory}",
    "AdminPasswordSha512": "{AdminPasswordSha512}",
    "DNApiKey": "{DNApiKey}",
    "DDocsApiKey": "{DDocsApiKey}",
    "DJobApiKey": "{DJobApiKey}",
    "CorsAllowedOrigins": "{CorsAllowedOrigins}"
  },

  "OptionsDDocsApiClient": {
    "ApiKey": "{OptionsDDocsApiClient_ApiKey}",
    "ServerUrl": "{OptionsDDocsApiClient_ServerUrl}"
  },

  "Vinca": {
    "OptionsVIndexNow": {
      "Key": "{Vinca_OptionsVIndexNow_Key}",
      "Host": "{Vinca_OptionsVIndexNow_Host}",
      "KeyLocation": "{Vinca_OptionsVIndexNow_KeyLocation}",
      "SubmitUrl": "{Vinca_OptionsVIndexNow_SubmitUrl}"
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "DNDocs": "Trace"
    },
    "Console": {
      "LogLevel": {
        "Default": "Error",
        "DNDocs": "Trace"
      }
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "{Kestrel_Http_Url}"
      }
    }
  }
}
